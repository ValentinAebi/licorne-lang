package licorne.closures;

class HeapVar(var value: Any?) {

    fn get(this) -> Any? {
        return value;
    }

    fn set(this, newVal: Any?) {
        this.value = newVal;
    }

}

class IntHeapVar(var value: Int) {

    fn get(this) -> Int {
        return value;
    }

    fn set(this, newVal: Int) {
        this.value = newVal;
    }

}

