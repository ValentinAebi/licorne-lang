package licorne.io;

import licorne.collections.SinglyLinkedList;
import licorne.collections.SinglyLinkedLists;

object Files {

    fn readAllLines(path: String) -> SinglyLinkedList[String] =
        SinglyLinkedLists.listFromArray(FilePrimitives.readAllLines(path))

    fn write(path: String, content: String) {
        FilePrimitives.writeFile(path, content);
    }

}
