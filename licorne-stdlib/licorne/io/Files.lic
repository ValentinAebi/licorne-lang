package licorne.io;

import licorne.collections.LList;
import licorne.collections.LLists;

object Files {

    fn readAllLines(path: String) -> LList[String] =
        LLists.listFromArray(FilePrimitives.readAllLines(path))

    fn write(path: String, content: String) {
        FilePrimitives.writeFile(path, content);
    }

}
