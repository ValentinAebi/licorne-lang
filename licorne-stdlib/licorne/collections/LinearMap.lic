package licorne.collections

// TODO more efficient Map type
class LinearMap[K : Any, V : Any] : MutMap[K, V] {
    val entries = ArrayList[Pair[K, V]]()

    fun size(): Cnt = entries.size()

    fun iterator(): Iterator[Pair[K, V]] = entries.iterator()

    fun contains(k: K): Boolean = getEntryIdx(k) != null

    fun get(k: K): V? {
        val idx = getEntryIdx(k)
        return if (idx == null) null else entries.get(idx).second()
    }
    
    fun put(k: K, v: V): V? {
        val idx = getEntryIdx(k)
        if (idx == null) {
            entries.add(Pair(k, v))
            return null
        } else {
            val retVal = entries.get(idx).second()
            entries.set(idx, Pair(k, v))
            return retVal
        }
    }

    fun remove(k: K): V? {
        val idx = getEntryIdx(k)
        if (idx == null) {
            return null
        } else {
            val retVal = entries.get(idx).second()
            entries.remove(idx)
            return retVal
        }
    }

    fun map[L : Any, W : Any](f: (K, V) -> Pair[L, W]): LinearMap[L, W] {
        val mapped = LinearMap()
        mapped.putAll(entries.map { f(it.first(), it.second()) })
        return mapped
    }

    fun filter(predicate: pure (K, V) -> Boolean): LinearMap[K, V] {
        val filtered = LinearMap()
        for (p in this) {
            if (predicate(p.first(), p.second())) {
                filtered.put(p.first(), p.second())
            }
        }
        return filtered
    }

    fun filterByKey(predicate: pure (K) -> Boolean): LinearMap[K with predicate(it), V] {
        val filtered = LinearMap()
        for (p in this) {
            if (predicate(p.first())) {
                filtered.put(p.first(), p.second())
            }
        }
        return filtered
    }

    fun filterByValue(predicate: pure (V) -> Boolean): LinearMap[K, V with predicate(it)] {
        val filtered = LinearMap()
        for (p in this) {
            if (predicate(p.second())) {
                filtered.put(p.first(), p.second())
            }
        }
        return filtered
    }

    private fun getEntryIdx(k: K): [0..]? {
        var idx = 0
        for (e in entries) {
            if (e.first() == k) {
                return idx
            }
            idx += 1
        }
        return null
    }

}
