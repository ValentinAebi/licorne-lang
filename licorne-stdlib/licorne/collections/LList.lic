package licorne.collections


sealed interface LList[out T] : ImmutSeq[T] {

    fun iterator(): Iterator[T] = LListIterator(this)

    pure fun get(i: Idx(this)): T {
        var j = i
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            if (j == 0) {
                return ls.head()
            }
            j -= 1
        }
        // unreachable
        panic "out of bounds"
    }

    fun indexOf[U super T](u: U): [0..]? {
        var idx = 0
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            if (ls.head() == u) {
                return idx
            }
            idx += 1
        }
        return null
    }

    fun map[U](f: (T) -> U): LList[U] {
        var rev = Nil()
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            rev = Cons(f(ls.head()), rev)
        }
        return rev.reversed()
    }

    fun filter(pred: pure (T) -> Boolean): LList[T with pred(it)] {
        var rev = Nil()
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            if (pred(ls.head())) {
                rev = Cons(ls.head(), rev)
            }
        }
        return rev.reversed()
    }

    pure fun reversed(): LList[T] {
        var res = Nil()
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            res = Cons(ls.head(), res)
        }
        return res
    }

}

data class Cons[out T](val head: T, val tail: LList[T]) : LList[T] {
    pure fun size(): Cnt = tail.size() + 1
}

data class Nil : LList[Nothing] {
    pure fun size(): Cnt = 0
}


object LLists {

    fun listFromArray[T](a: Array[T]): LList[T] with it.size() == a.size() {
        var ls = Nil()
        for (var i = a.size() - 1; i >= 0; i -= 1) {
            ls = Cons(a.get(i), ls)
        }
        return ls!!
    }
    
}
