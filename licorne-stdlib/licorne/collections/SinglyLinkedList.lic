package licorne.collections


datatype LList[+T] : ImmutSeq[T] {

    pure fn get(i: Idx(this)) -> T {
        var j = i
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            if (j == 0) {
                return ls.head()
            }
            j -= 1
        }
        // unreachable
        panic "out of bounds"
    }

    fn map[U](f: (T) -> U) -> LList[U] {
        var rev = Nil()
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            rev = Cons(f(ls.head()), rev)
        }
        return rev.reversed()
    }

    fn filter(pred: pure (T) -> Bool) -> LList[T with pred(it)] {
        var rev = Nil()
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            if (pred(ls.head())) {
                rev = Cons(ls.head(), rev)
            }
        }
        return rev.reversed()
    }

    fn foreach(action: (T) -> Unit) {
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            action(ls.head())
        }
    }

    pure fn reversed() -> LList[T] {
        var res = Nil()
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            res = Cons(ls.head(), res)
        }
        return res
    }

}

record Cons[+T](head: T, tail: LList[T]) : LList[T] {
    pure fn size() -> Cnt = tail.size() + 1
}

record Nil : LList[Nothing] {
    pure fn size() -> Cnt = 0
}


object LLists {

    fn listFromArray[T](a: Array[T]) -> LList[T] with it.size() == a.size() {
        var ls = Nil()
        for (var i = a.size() - 1; i >= 0; i -= 1) {
            ls = Cons(a.get(i), ls)
        }
        return ls!!
    }
    
}
