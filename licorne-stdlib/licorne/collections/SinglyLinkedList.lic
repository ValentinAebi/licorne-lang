package licorne.collections;


datatype SinglyLinkedList[+T] : Seq[T] {

    pure fn get(i: Idx(this)) -> T {
        var j = i;
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            if (j == 0) {
                return ls.head();
            };
            j -= 1;
        };
        // unreachable
        panic "out of bounds";
    }

    fn map[U](f: fn (T) -> U) -> SinglyLinkedList[U] {
        var rev = new Nil();
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            rev = new Cons(head = f(ls.head()), tail = rev);
        };
        return rev.reverse();
    }

    fn filter(pred: pure fn (T) -> Bool) -> SinglyLinkedList[T with pred(it)] {
        var rev = new Nil();
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            if (pred(ls.head())) {
                rev = new Cons(head = ls.head(), tail = rev);
            }
        };
        return rev.reverse();
    }

    fn foreach(action: fn (T) -> Unit) {
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            action(ls.head());
        }
    }

    pure fn reverse() -> SinglyLinkedList[T] {
        var res = new Nil();
        for (var ls = this; ls is Cons; ls = ls.tail()) {
            res = new Cons(head = ls.head(), tail = res);
        };
        return res;
    }

}

record Cons[+T](head: T, tail: SinglyLinkedList[T]) : SinglyLinkedList[T] {
    pure fn size() -> Cnt = tail.size() + 1
}

record Nil : SinglyLinkedList[Nothing] {
    pure fn size() -> Cnt = 0
}


object SinglyLinkedLists {

    fn listFromArray[T](a: Array[T]) -> SinglyLinkedList[T] with it.size() == a.size() {
        var ls = new Nil();
        for (var i = a.size() - 1; i >= 0; i -= 1) {
            ls = new Cons(head = a.get(i), tail = ls);
        };
        return ls!!;
    }
    
}
