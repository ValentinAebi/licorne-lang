package licorne.core

private(licorne) class ArrayIterator[T](val array: Array[T], val limit: Pos(array) = array.size()) : Iterator[T] {
    var idx: Idx(array) = 0
    var terminated = false

    fun hasNext(): Boolean = !terminated

    fun next(): T {
        if (terminated) {
            panic "Iterator: no next element"
        }
        val elem = array.get(idx)
        val currIdx = this.idx
        if (currIdx + 1 < limit) {
            idx = currIdx + 1
        } else {
            terminated = true
        }
        return elem
    }
    
}
