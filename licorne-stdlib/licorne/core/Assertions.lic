package licorne.core

typealias ReturnsWhen(cond: Bool) = if (cond) Unit else Nothing

object Assertions {

    fun assert(cond: Bool, msg: String?) -> ReturnsWhen(cond) {
        if (!cond) {
            panic mkErrorMsg("assertion failed", msg)
        }
    }

    fun assert(cond: Bool) -> ReturnsWhen(cond) = assert(cond, null)

    fun require(cond: Bool, msg: String?) -> ReturnsWhen(cond) {
        if (!cond) {
            panic mkErrorMsg("requirement failed", msg)
        }
    }

    fun require(cond: Bool) -> ReturnsWhen(cond) = require(cond, null)

    private fun mkErrorMsg(header: String, userMsg: String?) -> String =
        header ++ (if (userMsg == null) "" else ": " ++ userMsg)

}
