package licorne.core

typealias ReturnsWhen(cond: Boolean) = if (cond) Unit else Nothing

object Assertions {

    fun assert(cond: Boolean, msg: String?): ReturnsWhen(cond) {
        if (!cond) {
            panic mkErrorMsg("assertion failed", msg)
        }
    }

    fun assert(cond: Boolean): ReturnsWhen(cond) = assert(cond, null)

    fun require(cond: Boolean, msg: String?): ReturnsWhen(cond) {
        if (!cond) {
            panic mkErrorMsg("requirement failed", msg)
        }
    }

    fun require(cond: Boolean): ReturnsWhen(cond) = require(cond, null)

    private fun mkErrorMsg(header: String, userMsg: String?): String =
        header ++ (if (userMsg == null) "" else ": " ++ userMsg)

}
