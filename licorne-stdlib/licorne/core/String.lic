package licorne.core;

// TODO maybe redefine String as String[C sub Char], to constrain the characters a String may contain?

typealias StringL(len: Cnt) = String with it.size() == len
typealias StringLMin(minLen: Cnt) = String with it.size() >= minLen

class String : Indexed {

    pure fn size() -> Cnt {
        panic "compiler stub"
    }

    pure fn isEmpty() -> Bool {
        panic "compiler stub"
    }

    pure fn concat(s: String) -> StringL(this.size() + s.size()) {
        panic "compiler stub"
    }

    pure fn startsWith(s: String) -> Bool {
        panic "compiler stub"
    }

    pure fn endsWith(s: String) -> Bool {
        panic "compiler stub"
    }

    pure fn indent(n: Cnt) -> StringL(this.size() + n) {
        panic "compiler stub"
    }

    pure fn indexOf(s: String) -> Idx(this)? =
        sanitizeIndexOfResult(javaIndexOf(s))

    pure fn lastIndexOf(s: String) -> Idx(this)? =
        sanitizeIndexOfResult(javaLastIndexOf(s))

    pure fn repeat(n: Cnt) -> StringL(n * size()) {
        panic "compiler stub"
    }

    pure fn replace(target: String, replacement: String) -> String {
        panic "compiler stub"
    }

    pure fn substring(begin: Idx(this), end: Idx(this) where begin <= end) -> StringLMin(end - begin) {
        panic "compiler stub"
    }

    pure fn toLowerCase() -> StringL(this.size()) {
        panic "compiler stub"
    }

    pure fn toUpperCase() -> StringL(this.size()) {
        panic "compiler stub"
    }

    // TODO charAt and toCharArray when Chars are supported
    // TODO maybe add split (but it uses regexes, maybe it can be implemented in Licorne directly)

    private pure fn javaIndexOf(s: String) -> [-1 ..< size()] {
        panic "compiler stub"
    }

    private pure fn javaLastIndexOf(s: String) -> [-1 ..< size()] {
        panic "compiler stub"
    }

    private pure fn sanitizeIndexOfResult(i: [-1 ..< size()]) -> Idx(this)? =
        when i == -1 then null else i

}

object Strings {
    fn str(a: Any?) -> String {
        panic "compiler stub"
    }
}
