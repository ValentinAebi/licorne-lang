package licorne.core

// TODO maybe redefine String as String[C sub Char], to constrain the characters a String may contain?

typealias StringL(len: Cnt) = String with it.size() == len
typealias StringLMin(minLen: Cnt) = String with it.size() >= minLen
typealias NonEmptyString = StringLMin(1)

class String : Indexable {

    pure fun size(): Cnt = length()

    private pure fun length(): Cnt {
        panic "compiler stub"
    }

    pure fun isEmpty(): Bool {
        panic "compiler stub"
    }

    pure fun concat(s: String): StringL(this.size() + s.size()) {
        panic "compiler stub"
    }

    pure fun startsWith(s: String): Bool {
        panic "compiler stub"
    }

    pure fun endsWith(s: String): Bool {
        panic "compiler stub"
    }

    pure fun indent(n: Cnt): StringL(this.size() + n) {
        panic "compiler stub"
    }

    pure fun indexOf(s: String): Idx(this)? =
        sanitizeIndexOfResult(javaIndexOf(s))

    pure fun lastIndexOf(s: String): Idx(this)? =
        sanitizeIndexOfResult(javaLastIndexOf(s))

    pure fun repeat(n: Cnt): StringL(n * size()) {
        panic "compiler stub"
    }

    pure fun replace(target: String, replacement: String): String {
        panic "compiler stub"
    }

    pure fun substring(begin: [0 .. this.size()], end: [0 .. this.size()] where begin <= end): StringLMin(end - begin) {
        panic "compiler stub"
    }

    pure fun toLowerCase(): StringL(this.size()) {
        panic "compiler stub"
    }

    pure fun toUpperCase(): StringL(this.size()) {
        panic "compiler stub"
    }

    pure fun charAt(i: Idx(this)): Char {
        panic "compiler stub"
    }

    pure fun get(i: Idx(this)): Char = charAt(i)

    pure fun count(c: Char): Cnt {
        var cnt = 0
        for (var i = 0; i < size(); i += 1) {
            if (charAt(i) == c) {
                cnt += 1
            }
        }
        return cnt
    }

    pure fun contains(substring: String): Bool {
        var i = 0
        var j = 0
        while (i < size() && j < substring.size()) {
            if (this.charAt(i) == substring.charAt(j)) {
                j += 1
            } else {
                j = 0
            }
            i += 1
        }
        return j == substring.size()
    }

    fun split(c: Char): Array[String] {
        val parts = Array(count(c) + 1){ "" }
        var partsIdx = 0
        for (var i = 0; i < size(); i += 1) {
            val curr = charAt(i)
            if (curr == c) {
                partsIdx += 1
            } else {
                parts.set(partsIdx, parts.get(partsIdx!!) ++ str(curr))
            }
        }
        return parts
    }

    fun toCharArray(): Array[Char] = Array(size()){ charAt(it) }

    fun trim(): String {
        var startIdx = 0
        while (startIdx < size() && isBlankChar(charAt(startIdx))) {
            startIdx += 1
        }
        var endIdx = size() - 1
        while (endIdx >= startIdx && isBlankChar(charAt(endIdx))) {
            endIdx -= 1
        }
        return substring(startIdx, endIdx + 1)
    }

    private fun isBlankChar(c: Char): Bool =
        c == ' ' || c == '\t'
    
    private pure fun javaIndexOf(s: String): [-1 ..< size()] {
        panic "compiler stub"
    }

    private pure fun javaLastIndexOf(s: String): [-1 ..< size()] {
        panic "compiler stub"
    }

    private pure fun sanitizeIndexOfResult(i: [-1 ..< size()]): Idx(this)? =
        if (i == -1) null else i

}

object Strings {
    fun str(a: Any?): String {
        panic "compiler stub"
    }
}
