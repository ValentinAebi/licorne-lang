package licorne.core


typealias ArrayL[T](len: Cnt) = Array[T] with it.size() == len
typealias ArrayLMin[T](minLen: Cnt) = Array[T] with it.size() >= minLen

class Array[T](public size: Cnt, initializer: (Idx(this)) -> T) : Indexed {

    fun get(i: Idx(this)): T {
        panic "stub, compiled to xALOAD"
    }

    fun set(i: Idx(this), elem: T) {
        panic "stub, compiled to xSTORE"
    }

    fun iterator___(): Iterator[T] {
        return ArrayIterator(this)
    }

    fun reverse() {
        var i = 0
        var j = size() - 1
        while (i < j) {
            swap(i, j)
            i += 1
            j -= 1
        }
    }

    fun swap(i: Idx(this), j: Idx(this)) {
        val tmp = get(i)
        set(i, get(j))
        set(j, tmp)
    }

    fun foreach(action: (T) -> Unit) {
        for (var i = 0; i < size(); i += 1) {
            action(get(i))
        }
    }

}

object Arrays {

    fun copy[T](src: Array[T]): ArrayL[T](src.size()) =
        Array(src.size()){ src.get(it) }

    fun copy[T](src: Array[T], dst: Array[T] where dst.size() >= src.size()) {
        for (var i = 0; i < src.size(); i += 1) {
            dst.set(i, src.get(i))
        }
    }

    fun toString[T](array: Array[T]): String {
        var s = "["
        for (var i = 0; i < array.size(); i += 1) {
            if (i > 0) {
                s ++= ","
            }
            s ++= str(array.get(i))
        }
        s ++= "]"
        return s
    }

}
