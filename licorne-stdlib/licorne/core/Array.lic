package licorne.core;


typealias ArrayL[T](len: Cnt) = Array[T] with it.size() == len
typealias ArrayLMin[T](minLen: Cnt) = Array[T] with it.size() == minLen

class Array[T](public size: Cnt, initializer: fn (Idx(this)) -> T) : Indexed {

    fn get(i: Idx(this)) -> T {
        panic "stub, compiled to xALOAD"
    }

    fn set(i: Idx(this), elem: T) {
        panic "stub, compiled to xSTORE"
    }

    fn reverse() {
        var i = 0;
        var j = size() - 1;
        while (i < j) {
            swap(i, j);
            i += 1;
            j -= 1;
        }
    }

    fn swap(i: Idx(this), j: Idx(this)) {
        val tmp = get(i);
        set(i, get(j));
        set(j, tmp);
    }

}

object Arrays {

    fn copy[T](src: Array[T]) -> ArrayL[T](src.size()) =
        new Array(src.size(), |src.get(it)|)

    fn copy[T](src: Array[T], dst: Array[T] where dst.size() >= src.size()) {
        for (var i = 0; i < src.size(); i += 1) {
            dst.set(i, src.get(i));
        }
    }

}
