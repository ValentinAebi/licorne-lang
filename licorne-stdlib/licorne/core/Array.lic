package licorne.core;


typealias ArrayL[T](len: Cnt) = Array[T] with it.size() == len
typealias ArrayLMin[T](minLen: Cnt) = Array[T] with it.size() == minLen

class Array[T](public size: Cnt, initializer: fn (Idx(this)) -> T) : Indexed {

    pure fn get(i: Idx(this)) -> T {
        panic "stub, compiled to xALOAD"
    }

    fn set(i: Idx(this), elem: T) {
        panic "stub, compiled to xSTORE"
    }

}
