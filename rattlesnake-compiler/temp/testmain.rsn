
object Test {

   fn clamp(x: Int, min: Int, max: Int) -> Int {
      val result: Int;
      if x <= min {
         result = min;
      } else if x >= max {
         return max;
      } else {
         result = x;
      };
      return result;
   }

   fn sum(n: Int) -> Int {
      var sum = 0;
      for var i = 0; i < n; i = i + 1 {
         sum = sum + i;
      };
      return sum;
   }

}
