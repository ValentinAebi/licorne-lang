
object Test {

   fn clamp(x: Int, min: Int, max: Int) -> Int {
      val result: Int;
      if x <= min {
         result = min;
      } else if x >= max {
         return max;
      } else {
         result = x;
      };
      return result;
   }

   fn sum(n: Int) -> Int {
      var sum = 0;
      for var i = 0; i < n; i += 1 {
         sum += i;
      };
      return sum;
   }

   fn produceOne(n: Int) -> Int {
      var t = 10;
      val a = t*t;
      if n < t {
         t -= 8;
         a -= 9 * (10 + 1)
      } else {
         t = 2;
         a = t - 1;
      };
      return t - a;
   }

}
