
const debug = false;
const log = true;

package Test {

    main fn test(arr String){

        // hardcoded for test
        val args = ["salut"]@newreg;

        if (debug){
            for var i = 0; i < len args; i += 1 {
                console.print(args[i]);
            }
        };
        if (len args < 1) {
            panic "no command"
        };
        val cmd = args[0];
        if (cmd == "hi"){
            log("They speak English\n");
            console.print("Hi! How are you?");
        } else if (cmd == "salut"){
            log("They speak French\n");
            console.print("Salut, ca va?");
        } else if (debug) {
            panic "Unknown language";
        } else {
            log("Sorry, I don't know this language");
        }
    }

    private fn log(s: String){
        if (log) {
            console.print(s);
        }
    }

}

