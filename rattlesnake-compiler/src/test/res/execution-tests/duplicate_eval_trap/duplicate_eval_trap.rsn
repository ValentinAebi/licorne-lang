
package Test {

    private fn foo(i: Int) -> Int {
        console.print("foo: " + i as String + "\n");
        return i*i - 4*i + 2;
    }

    private fn bar(d: Double) -> Double {
        console.print("bar: " + d as String + "\n");
        return d*d;
    }

    main fn test(arr String){
        var r = foo(0) <= foo(4);
        printYN(r);
        r = foo(0) < foo(4);
        printYN(r);
        r = bar(1.0) <= bar(-1.0);
        printYN(r);
        r = bar(1.0) < bar(-1.0);
        printYN(r);
        r = foo(0) >= foo(4);
        printYN(r);
        r = foo(0) > foo(4);
        printYN(r);
        r = bar(1.0) >= bar(-1.0);
        printYN(r);
        r = bar(1.0) > bar(-1.0);
        printYN(r);
    }

    private fn printYN(b: Bool){
        console.print(when b then "yes\n" else "no\n")
    }

}
