
interface Producer[+T, -A] {
   fn produce(this, arg: A) -> T
}

class DogProducer : Producer[Animal, Int] {
    fn produce(this, name: String) -> Dog with it.name() == name {      //> E : type mismatch on parameter name of method produce: type is String but should be Int since the method overrides produce in Producer[Animal,Int]
        return new Dog(name);
    }
}

interface Animal
class Dog(name: String) : Animal {
   fn name(this) -> String {
      return this.name;
   }
}
