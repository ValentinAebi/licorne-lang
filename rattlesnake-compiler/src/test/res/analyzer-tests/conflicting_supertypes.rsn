
interface List[T]
interface I[T]
interface J[S] : I[List[S]]
interface K[T] : I[List[List[T]]]
class Foo1 : J[Int], K[Int]          //> E : Foo1 subtypes both I[List[Int]] and I[List[List[Int]]]
class Foo2 : K[String], J[List[String]]
class Foo3 : K[Int], J[List[String]] //> E : Foo3 subtypes both I[List[List[Int]]] and I[List[List[String]]]
class Foo4 : I[String], List[Int]
class Foo5 : I[String], I[[1,]]  //> E : Foo5 subtypes both I[String] and I[[1,]]
