
typealias AtLeast(i: Int) = [i,]

object Main {

   fn clamp(x: Int, min: Int, max: [min,]) -> [min, max] {
      return
        when x < min then min
        else when x < max then x
        else max
   }

   fn foo(a: Int, x: AtLeast(a)) -> String {
      return clamp(x, 0, 10)    //> E : return value: expected String, found [0,10]
   }

   fn bar() {
      foo(42, "Hello")  //> E : second argument of call to foo: expected AtLeast(42), found String
   }

   fn abc(ls: List[Bool]) {
      ls.indexOf(true) : String     //> E : type ascription: expected String, found Idx(ls)
   }

}

typealias Length = AtLeast(0)
typealias Idx[T](ls: List[T]) = [ 0, ls.size()-1 ]

interface List[T] {
   fn size(this) -> Length
   fn indexOf(this, elem: T) -> Idx(this)
}
