
object DivByZero {

   fn ok1(x: Int, y: Int) -> Int =
      when y == 0 then y else x / y

   // TODO use set types and allow this
   //fn ok2(x: Int, var y: Int) -> Int {
   //   if y == 0 {
   //      y += 1;
   //   };
   //   return x / y;
   //}

   fn ok3(x: Int, y: [1,]) -> Int {
      return x / y;
   }

   fn ok4(x: [0,], y: Int) -> Int =
      when y > 0
      then x / y
      else y / (x + 1)

   fn ok5(x: Int, y: Int | y != 0) -> Int =
      x % y

   fn wrong1(x: Int, y: Int) -> Int =
      x % y                         //> E : I cannot prove that right-hand side y of operator '%' cannot be zero

   fn wrong2(x: Int, y: [1,]) -> Int {
      if x % 100 == 0 {
         return x % y;              // OK
      };
      return x / (y - 1);           //> E : I cannot prove that right-hand side y - 1 of operator '/' cannot be zero
   }

}
