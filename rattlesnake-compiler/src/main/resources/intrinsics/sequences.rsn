
typealias Length = Int with this >= 0
typealias Idx(seq: Sequence<Any>) = Int with 0 <= this && this < seq.length()

interface Sequence<+T> {
    fn length() -> Length
    fn get(idx: Idx(this)) -> T
}

class Array<T> : Sequence<T> {
    fn length() -> Length {
        // compiled to ARRAYLENGTH
    }
    fn get(idx: Idx<T>(this)) -> T {
        // compiled to xALOAD
    }
    fn update(idx: Idx<T>(this), value: T) -> Void {
        // compiled to xASTORE
    }
}
