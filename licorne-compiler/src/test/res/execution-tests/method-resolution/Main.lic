
object Main {

    fun main() {
        val a = A()
        a.foo(Dog())     // invokes the method in A
        a.foo(Dog(), 0)  // falls back to the method in I
        a.bar(42)            // invokes the method in A: do not resolve to the more precise (refinement) type in the supertype method
    }

}

interface I {
    open fun foo(d: Dog) {
        println("I.foo(#1)")
    }
    open fun foo(d: Dog, i: Int) {
        println("I.foo(#2)")
    }
    open fun bar(i: [0..10]) {
        println("I.bar(#1)")
    }
}

class A : I {
    fun foo(d: Dog) {
        println("A.foo(#1)")
    }
    fun bar(i: Int) {
        println("A.bar(#1)")
    }
}

interface Animal
class Dog : Animal
