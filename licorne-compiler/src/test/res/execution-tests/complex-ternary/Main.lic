
object Main {

    fun main() {
        val array = Array(2) { 0 }
        println(str(foo1(array)))
        println(str(foo2(array)))
    }

    private fun foo1(args: Array[Int]) -> Int {
        return if (args.size() == 0) {
            println("empty")
            42
        } else 0
    }

    private fun foo2(args: Array[Int]) -> Int =
        if (args.size() == 0) 42 else {
            println("nonempty")
            0
        }

}
