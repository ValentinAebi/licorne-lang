import Eithers.*

object Main {

    fn main() {
        val x = left(Dog())
        val y = right(Car())
        display(x)
        display(y)
    }

    private fn display(e: Either[Animal, Car]) {
        if (e is Left) {
            println(e.l().speak().toUpperCase())
        } else {
            println(e.r().maxPassengers())
        }
    }

}
