
object Main {

    fn main() {
        val cat = mkAnimal(false)
        cat.meow()
    }

    private fn mkAnimal(trueIfDog: Bool) -> if (trueIfDog) Dog else Cat =
        if (trueIfDog) new Dog() else new Cat()

}

interface Animal
class Dog : Animal
class Cat : Animal {
    fn meow() {
        println("Meow!")
    }
}
