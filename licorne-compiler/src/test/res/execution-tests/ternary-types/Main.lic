
object Main {

    fun main() {
        val cat = mkAnimal(false)
        cat.meow()
    }

    private fun mkAnimal(trueIfDog: Boolean): if (trueIfDog) Dog else Cat =
        if (trueIfDog) Dog() else Cat()

}

interface Animal
class Dog : Animal
class Cat : Animal {
    fun meow() {
        println("Meow!")
    }
}
