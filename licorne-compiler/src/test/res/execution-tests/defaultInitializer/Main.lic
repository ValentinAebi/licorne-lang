
object Main {

    fn main() {
        println(Foo(27, 38))
        println(Foo(59))
        println(Bar(21, 11, 27))
        println(Bar(32, 28, 11))
        println(Bar(88, 14))
        println(Bar(101, 25, -1))
    }

}

record Foo(a: Int, b: [a..] = a + 1) {
    fn toString() -> String {
        return "(" ++ str(a) ++ "," ++ str(b) ++ ")"
    }
}

record Bar(a: Int, b: Int = 0, c: Int = 2*a + 5) {
    fn toString() -> String {
        return "(" ++ str(a) ++ "," ++ str(b) ++ "," ++ str(c) ++ ")"
    }
}
