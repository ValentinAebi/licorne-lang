
object Main {

    fun main() {
        println(Foo(27, 38))
        println(Foo(59))
        println(Bar(21, 11, 27))
        println(Bar(32, 28, 11))
        println(Bar(88, 14))
        println(Bar(101, 25, -1))
    }

}

data class Foo(val a: Int, val b: [a..] = a + 1) {
    fun toString(): String {
        return "(" ++ str(a) ++ "," ++ str(b) ++ ")"
    }
}

data class Bar(val a: Int, val b: Int = 0, val c: Int = 2*a + 5) {
    fun toString(): String {
        return "(" ++ str(a) ++ "," ++ str(b) ++ "," ++ str(c) ++ ")"
    }
}
