import licorne.collections.SinglyLinkedList;
import licorne.collections.Cons;
import licorne.collections.Nil;

object Main {

    fn main() {
        val ls = reverse(new Cons(head = 1, tail = new Cons(head = 2, tail = new Nil())));
        println((ls as Cons).head());
    }

    private fn reverse[T](ls: SinglyLinkedList[T]) -> SinglyLinkedList[T] {
        var res: SinglyLinkedList[T] = new Nil();
        ls.foreach(fn (e) -> {
            res = new Cons(head = e, tail = res);
        });
        return res;
    }

}
