import licorne.collections.LList
import licorne.collections.LLists.listFromArray


object Main {

    fn main() {
        val array = Array[[0..]](10) { 0 }
        for (var i = 0; i < 10; i += 1) {
            array.set(i, 2*i)
        }
        val ls = listFromArray(array)
        ls.map { it + 1 }
          .filter { it < array.size() }
          .foreach { println(array.get(it)) }
    }

}
