
object Main {

    fn main() {
        val array = new Array(1, |100|);
        printElemUnsafe(array, 0);  // correct, prints 100
        printElemUnsafe(array, 10); //>STACKTRACE
    }

    private fn printElemUnsafe(xs: Array[Int], i: Int) {
        require(0 <= i && i < xs.size(), "not a valid index");
        println(xs.get(i));
    }

}
