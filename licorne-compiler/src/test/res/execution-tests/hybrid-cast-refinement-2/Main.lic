
object Main {

    fun main() {
        val s1 = mkString(true)!!    // OK
        foo(s1, 2!!)                 // OK
        val s2 = mkString(false)!!   // OK
        foo(s2, 10!!)                //>STACKTRACE
    }

    private fun mkString(b: Bool) -> String? = "Hello"

    private fun mkInt() -> Int = 2

    private fun foo(s: String, i: Idx(s)) {
        println(s)
        println(i)
    }

}
