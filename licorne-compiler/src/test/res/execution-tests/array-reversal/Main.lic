
object Main {

    private fn reverse[T](array: Array[T]) {
        var i = 0;
        var j = array.size()-1;
        while (i < j) {
            val tmp = array.get(i);
            array.set(i, array.get(j));
            array.set(j, tmp);
            i += 1;
            j -= 1;
        }
    }

    fn main() {
        val a = new Array(size = 10);
        for (var i = 0; i < 10; i += 1) {
            a.set(i, 2*i + 1);
        };
        reverse(a);
        for (var i = 0; i < a.size(); i += 1) {
            println(a.get(i));
        }
    }

}
