
object Main {

    fun main() {
        takeAnimal(Tiger())
        takeAnimal(Dolphin())
        return unit
    }

    private fun takeAnimal(a: Animal) {
        val descr = describe(a)
        if (descr == null) {
            println()
        } else {
            display(descr)
        }
        val u = unit
        return u
    }

    private fun describe(a: Animal): String? =
        if (a.isMarine()) "marine" else null

    private fun display(s: String) {
        println(s)
        return   // implicit unit literal
    }

}

interface Animal {
    fun isMarine(): Boolean
}

class Tiger : Animal {
    fun isMarine(): Boolean = false
}

class Dolphin : Animal {
    fun isMarine(): Boolean = true
}
