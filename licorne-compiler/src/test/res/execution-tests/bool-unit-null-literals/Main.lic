
object Main {

    fn main() {
        takeAnimal(Tiger())
        takeAnimal(Dolphin())
        return unit
    }

    private fn takeAnimal(a: Animal) {
        val descr = describe(a)
        if (descr == null) {
            println()
        } else {
            display(descr)
        }
        val u = unit
        return u
    }

    private fn describe(a: Animal) -> String? =
        if (a.isMarine()) "marine" else null

    private fn display(s: String) {
        println(s)
        return   // implicit unit literal
    }

}

interface Animal {
    fn isMarine() -> Bool
}

class Tiger : Animal {
    fn isMarine() -> Bool = false
}

class Dolphin : Animal {
    fn isMarine() -> Bool = true
}
