
object PositiveMax {

    fn maxPos_correct(a: Array[Int]) -> [0..] {
        var k = 0;
        var max = 0;
        while (k < a.length()) {
            val v = a.at(k);
            if (v > 0 && v > max) {
                max = v;
            };
            k += 1;
        };
        return max;
    }

    fn maxPos_buggy(a: Array[Int]) -> [0..] {
        var k = 0;
        var max = 0;
        // ERROR: should be <
        while (k <= a.length()) {
            val v = a.at(k);        //> E : first argument of call to at: expected Idx[T](a), found k<loop-body-start@21:33> : [0 .. a.length()]
            if (v > 0 && v > max) {
                max = v;
            };
            k += 1;
        };
        return max;
    }

    fn maxPos_moreComplex_correct(a: Array[Int], start: Idx(a), incEven: [1..], incOdd: [1..]) -> [0..] {
        var k = start;
        var max = 0;
        while (k < a.length()) {
            val v = a.at(k);
            if (v > 0 && v > max) {
                max = v;
            };
            if k % 2 == 0 {
                k += incEven;
            } else {
                k += incOdd;
            }
        };
        return max;
    }

    fn maxPos_moreComplex_buggy(a: Array[Int], start: Idx(a), incEven: [1..], incOdd: Int) -> [0..] {
        var k = start;
        var max = 0;
        while (k < a.length()) {    //> E : inferred incorrect type Idx[T](a) for variable k at loop body start, please provide a type annotation at variable declaration site
            val v = a.at(k);
            if (v > 0 && v > max) {
                max = v;
            };
            if k % 2 == 0 {
                k += incEven;
            } else {
                k += incOdd;      // ERROR: incOdd may be negative
            }
        };
        // the dead code report here seems to be a spurious error caused by the one earlier in the function, the corresponding annotation can be removed if we modify the type-checker and this error disappears
        return max;     //> E : dead code
    }

}

typealias Length = [0..]
typealias Idx[T](arr: Array[T]) = [0 ..< arr.length()]

class Array[T](public length: Length) {

    fn at(this, i: Idx(this)) -> T {
        panic "compile to bytecode xALOAD"
    }

}

