
interface Collection[T] {
   fn map[U](f: pure (T) -> U) -> Collection[U]
   fn foreach(f: (T) -> Unit)
}

object Test {

   fn useCollection(coll: Collection[Int], maybePureClosure: (Int) -> Int) {
      var sum = 0

      val pureClosure = { it * it }     // inferred as pure
      val impureClosure: (Int) -> Unit = { sum += it }

      coll.foreach(pureClosure)      // OK
      coll.foreach(maybePureClosure) // OK
      coll.foreach(impureClosure)    // OK

      coll.map(pureClosure)          // OK
      coll.map(maybePureClosure)     //> E : first argument of call to map: expected pure (Int) -> Int, found maybePureClosure : (Int) -> Int
      coll.map(impureClosure)        //> E : first argument of call to map: expected pure (Int) -> Unit, found impureClosure : (Int) -> Unit
   }

   pure fn useClosure(cl: (String) -> String) -> String {
      val s = "Hello world!"
      return cl(s)      //> E : illegal invocation of an impure closure in a pure method or closure
   }

   pure fn dontUseClosure(cl: (String) -> String) -> String {
      return "Hello!"   // OK
   }

   fn useClosureInPureClosure(cl: (String) -> String) -> pure () -> String {
      return {
        cl("Hello")     //> E : illegal invocation of an impure closure in a pure method or closure
      }
   }

   pure fn produceImpureClosure() -> (Container[Int]) -> Unit {
      return { container -> container.set(42) }     // OK
   }

   fn createPureClosures() {
      val f: pure (Int) -> Int = { it }                            // OK, purity detected
      val g: pure (Pair[Int, String]) -> String = { it.right() }   // OK
   }

}

class Container[T](var value: T) {
   fn set(newVal: T) {
      this.value = newVal
   }
}

record Pair[A,B](left: A, right: B)
