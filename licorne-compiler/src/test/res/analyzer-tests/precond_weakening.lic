
interface I {
   fn foo(i: Int, j: [0..i] where Math.abs(i) < 10) -> Int
}

class A : I {
   fn foo(i: Int, j: Int) -> [0..] {                           // OK
      panic "not implemented"
   }
}

class B : I {
   fn foo(i: Int, j: Int where Math.abs(i) < 20) -> Int {     // OK
      panic "not implemented"
   }
}

class C : I {
   fn foo(i: Int, j: Int where Math.abs(i) < 8) -> Int {           //> E : foo(#2) in C overrides foo(#2) in I but I cannot prove that the precondition of the overridden method is respected
      panic "not implemented"
   }
}

class D : I {
   fn foo(i: Int, j: [-i..i]) -> [0..] {                           //> E : type mismatch on parameter j of method foo(#2): declared type [-i..i] is not a supertype of the type [0..i] of the corresponding parameter in the overridden method foo(#2) in I
      panic "not implemented"
   }
}

object Math {
   pure fn abs(i: Int) -> [0..] = when i < 0 then -i else i
}
