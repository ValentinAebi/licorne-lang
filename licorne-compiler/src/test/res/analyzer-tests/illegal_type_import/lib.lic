package example.lib

private(example) interface I
private(example.lib) interface J

data class Abc(val i: Int)
private(example) data class Foo(val i: Int) : J     // wrong, but ignored since the compiler does not reach the phase that would detect it (see "subtype_violating_visibility" test)
private(example.lib) data class Bar(val i: Int) : J
private data class Wxyz(val i: Int)

object Lib {
    fun useWxyz() {
        Wxyz(0)
    }
}
