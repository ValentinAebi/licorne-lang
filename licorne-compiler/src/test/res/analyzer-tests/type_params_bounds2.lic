interface Animal
interface Vertebrate : Animal
interface Mammal : Vertebrate
interface Dog : Mammal
interface Cat : Mammal

record R[A, B sub A](a: A, b: B)

object Test {

   fn testF(animal: Animal, dog: Dog) -> Unit {
      R(animal, dog)
      R(dog, animal)  //> E : type variable B has been resolved to type Animal, which violates its upper bound Dog
   }

}
