object Main {

    fn main() {
        val s1 = new FixedLenSeq(5, 0);
        s1.set(1, 42);
        s1.set(2, 100);
        println(s1.get(2));
    }

}

class FixedLenSeq[T](public size: Cnt, defaultElem: T) : Indexable {
    val array: Array[T] = new Array(size, |defaultElem|)    //> W : type annotation licorne.core.Array[T] on field array hides its actual type licorne.core.Array[T] with it.size() == size (inferred from the initializer), which might cause type checking errors at field use sites

    fn set(i: Idx(this), elem: T) {
        array.set(i, elem)      //> E : first argument of call to set: expected licorne.core.Idx(this.array()), found i : licorne.core.Idx(this)
    }

    fn get(i: Idx(this)) -> T {
        return array.get(i)     //> E : first argument of call to get: expected licorne.core.Idx(this.array()), found i : licorne.core.Idx(this)
    }
}
