
class Foo {

   pure fn bar(animal: Animal) -> Unit {
      animal.hungerLevel();             //> E : illegal call to impure method hungerLevel
      animal.hungerLevel_incorrect1();  // OK
      animal.name();                    // OK
   }

}

class Animal(name: String, var hungerLevel: [0..]) {

   fn eat(food: Food) {
      val hungerLevelBefore = this.hungerLevel;
      if hungerLevelBefore < food.nutrients() {
         resetHungerLevel();
      } else {
         this.hungerLevel = hungerLevelBefore - food.nutrients();
      }
   }

   fn resetHungerLevel() {
      this.hungerLevel = 0;
   }

   pure fn resetHungerLevel_incorrect() {
      this.hungerLevel = 0;     //> E : illegal access to impure field hungerLevel
   }

   fn hungerLevel() -> [0..] = this.hungerLevel                    // OK
   fn hungerLevelDuplicate() -> [0..] = this.hungerLevel()         // OK
   pure fn hungerLevel_incorrect1() -> [0..] = this.hungerLevel    //> E : illegal access to impure field hungerLevel
   pure fn hungerLevel_incorrect2() -> [0..] = this.hungerLevel()  //> E : illegal call to impure method hungerLevel

   pure fn name() -> String = this.name
   pure fn getName1() -> String {
      return this.name;
   }
   fn getName2() -> String {
      return this.name;
   }

}

class Food(public nutrients: [0..])
