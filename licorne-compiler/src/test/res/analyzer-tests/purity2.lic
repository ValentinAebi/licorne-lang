
class Foo {

   pure fn bar(this, animal: Animal) -> Unit {
      animal.hungerLevel();             //> E : illegal call to impure method hungerLevel
      animal.hungerLevel_incorrect1();  //> W : no arguments list required for call to pure method hungerLevel_incorrect1
      animal.name;                    // OK
   }

}

class Animal(name: String, var hungerLevel: [0..]) {

   fn eat(this, food: Food) {
      val hungerLevelBefore = this.hungerLevel;
      if hungerLevelBefore < food.nutrients {
         resetHungerLevel();
      } else {
         this.hungerLevel = hungerLevelBefore - food.nutrients;
      }
   }

   fn resetHungerLevel(this) {
      this.hungerLevel = 0;
   }

   pure fn resetHungerLevel_incorrect(this) {
      this.hungerLevel = 0;     //> E : illegal access to impure field hungerLevel
   }

   fn hungerLevel(this) -> [0..] = this.hungerLevel                    // OK
   fn hungerLevelDuplicate(this) -> [0..] = this.hungerLevel()         // OK
   pure fn hungerLevel_incorrect1(this) -> [0..] = this.hungerLevel    //> E : illegal access to impure field hungerLevel
   pure fn hungerLevel_incorrect2(this) -> [0..] = this.hungerLevel()  //> E : illegal call to impure method hungerLevel

   pure fn name(this) -> String = this.name
   pure fn getName1(this) -> String {
      return this.name;
   }
   fn getName2(this) -> String {
      return this.name;
   }

}

class Food(public nutrients: [0..])
