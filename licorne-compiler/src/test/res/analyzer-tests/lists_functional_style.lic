package lists

import lists.Lists.{zip, length, filter}

typealias Length = [0..]

sealed interface List[out T]
data class Nil : List[Nothing]
data class Cons[out T](val head: T, val tail: List[T]) : List[T]

data class Pair[out L, out R](val l: L, val r: R)

object Lists {

   pure fun length[A](var ls: List[A]): Length {
      var len = 0
      while (ls is Cons) {
         len += 1
         ls = ls.tail()
      }
      return len
   }

   fun length_bad[A](var ls: List[A]): Length {
      var len = -1
      while (ls is Cons) {
         len += 1
         ls = ls.tail()
      }
      return len //> E : return value: expected lists.Length, found len : [-1..]
   }

   fun sum(var ls: List[[0..]]): [0..] {
      var s = 0
      while (ls is Cons) {
         s += ls.head()
         ls = ls.tail()
      }
      return s
   }

   fun sum_bad(var ls: List[[..1000]]): [0..] {
      var s = 0
      while (ls is Cons) {    //> E : I could not find a type for variable s that stays valid for all iterations of the loop (I attempted with [0..]), please provide a type annotation at variable declaration (on line 43)
         s += ls.head()
         ls = ls.tail()
      }
      return s
   }

   fun reverse[T](var ls: List[T]): List[T] {
      var reversed = Nil()
      while (ls is Cons) {
         reversed = Cons(ls.head(), reversed)
         ls = ls.tail()
      }
      return reversed
   }

   fun filterLessOrEq(a: Int, var ls: List[Int]): List[[..a]] {
      var filteredReversed = Nil()
      while (ls is Cons) {
         if (ls.head() <= a) {
            filteredReversed = Cons(ls.head(), filteredReversed)
         }
         ls = ls.tail()
      }
      return reverse(filteredReversed)
   }

   fun filterLessThan(a: Int, var ls: List[Int]): List[[..<a]] {
      var filteredReversed = Nil()
      while (ls is Cons) {
         if (ls.head() < a) {
            filteredReversed = Cons(ls.head(), filteredReversed)
         }
         ls = ls.tail()
      }
      return reverse(filteredReversed)
   }

   fun filterLessThan_bad1(a: Int, var ls: List[Int]): List[[..<a]] {
      var filteredReversed = Nil()
      while (ls is Cons) {
         if (ls.head() <= a) {
            filteredReversed = Cons(ls.head(), filteredReversed) //> E : first argument of call to constructor: expected [..<a], found ls.head() : [..a]
         }
         ls = ls.tail()
      }
      return reverse(filteredReversed)
   }

   fun filterLessThan_bad2(a: Int, var ls: List[Int]): List[[..<a]] {
      var filteredReversed: List[[..<a]] = Nil()
      while (ls is Cons) {
         if (ls.head() <= a) {
            filteredReversed = Cons(ls.head(), filteredReversed) //> E : first argument of call to constructor: expected [..<a], found ls.head() : [..a]
         }
         ls = ls.tail()
      }
      return reverse(filteredReversed)
   }

   fun filter[T](var ls: List[T], p: pure (T) -> Bool): List[T with p(it)] {
      var filteredReversed = Nil()
      while (ls is Cons) {
         if (p(ls.head())) {
            filteredReversed = Cons(ls.head(), filteredReversed)
         }
         ls = ls.tail()
      }
      return reverse(filteredReversed)
   }

   fun filter_bad[T](var ls: List[T], p: pure (T) -> Bool): List[T with p(it)] {
      var filteredReversed = Nil()
      while (ls is Cons) {
         if !(p(ls.head())) {
            filteredReversed = Cons(ls.head(), filteredReversed) //> E : first argument of call to constructor: expected T with p(it), found ls.head() : T with !p(it)
         }
         ls = ls.tail()
      }
      return reverse(filteredReversed)
   }

   fun filterLessThanSimpler(a: Int, ls: List[Int]): List[[..a-1]] =
      filter(ls) { it < a }

   fun filterLessThanSimpler_bad(a: Int, ls: List[Int]): List[[..a-1]] =
      filter(ls) { it <= a }  //> E : return value: expected lists.List[[..<a]], found lists.List[[..a]]

   fun isSingletonList[T](ls: List[T]): Bool =
      ls is Cons && ls.tail() is Nil

   fun zip[S, T](ls1: List[S], ls2: List[T] where length(ls1) == length(ls2)): List[Pair[S, T]] {
      var rem1 = ls1
      var rem2 = ls2
      var reversedZip = Nil()
      while (rem1 is Cons && rem2 is Cons) {
         reversedZip = Cons(Pair(rem1.head(), rem2.head()), reversedZip)
         rem1 = rem1.tail()
         rem2 = rem2.tail()
      }
      return reverse(reversedZip)
   }

}

object UseLists {

   fun useZipCorrectly1(integers: List[Int], strings: List[String] where length(integers) == length(strings)): List[Pair[Int, String]] {
      return zip(integers, strings)
   }

   fun useZipCorrectly2(integers: List[Int], strings: List[String]): List[Pair[Int, String]] =
      if (length(integers) == length(strings)) zip(integers, strings)
      else Nil()

   fun useZipCorrectly3(integers: List[Int], strings: List[String]): List[Pair[Int, String]] =
      if (length(integers) != length(strings)) Nil()
      else zip(integers, strings)

   fun useZipIncorrectly(integers: List[Int], strings: List[String]): List[Pair[Int, String]] {
      return zip(integers, strings)   //> E : illegal call to zip: I cannot prove that its precondition lists.Lists.length[S](integers) == lists.Lists.length[T](strings) holds
   }

   fun instanceTests(ls: List[I], thres: Int) {
      val filtered = filter(ls) { it is A && it.value() >= thres }
      filtered : Nothing //> E : type ascription: expected Nothing, found filtered : lists.List[lists.A with thres <= it.value()] (where I am unable to prove the stability of the following values: it.value())
   }

}

interface I
class A : I {
   pure fun value(): Int = 42
}
