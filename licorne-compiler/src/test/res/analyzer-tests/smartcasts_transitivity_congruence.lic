
typealias Nat = [0..]

object Test {

   fun transitivity(i: [0..], j: [0..], k: [0..]) {
      if (i != j) {
         return
      }
      if (i < k) {
         j : [0..<k]        // OK
      } else {
         j : [0..k]          //> E : type ascription: expected [0..k], found j : [0..]
      }
   }

   fun congruence(a: Int, b: Int): [1..] {
      if (foo(a) > 0 && a == b) {
         return foo(b)   // OK
      } else if (foo(a) > 10) {
         return foo(b)   //> E : return value: expected [1..], found Test.foo(b) : Int
      } else {
         return 1
      }
   }

   pure fun foo(x: Int): Int = x * x + 1

   fun eClassMergeAfter(a: Int, b: Int, x: Int, y: Int): Nothing {
      if (x < b && y >= a && x == y) {
         return x    //> E : return value: expected Nothing, found x : [a..<b]
      }
      panic "error"
   }

   fun eClassMergeBefore(a: Int, b: Int, x: Int, y: Int): Nothing {
      if (x == y && x < b && y >= a) {
         return x    //> E : return value: expected Nothing, found x : [a..<b]
      }
      panic "error"
   }

   fun eClassMergeInBetween(a: Int, b: Int, x: Int, y: Int): Nothing {
      if (x < b && x == y && y >= a) {
         return x    //> E : return value: expected Nothing, found x : [a..<b]
      }
      panic "error"
   }

}
