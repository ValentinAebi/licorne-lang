package lists;

import lists.Lists.{zip, length, filter};

typealias Length = [0..]

datatype List[+T]
record Nil : List[Nothing]
record Cons[+T](head: T, tail: List[T]) : List[T]

record Pair[L, R](l: L, r: R)

object Lists {

   pure fn length[A](var ls: List[A]) -> Length {
      var len = 0;
      while ls is Cons {
         len += 1;
         ls = ls.tail;
      };
      return len;
   }

   fn length_bad[A](var ls: List[A]) -> Length {
      var len = -1;
      while ls is Cons {
         len += 1;
         ls = ls.tail;
      };
      return len;   //> E : return value: expected lists.Length, found len<loop-body-start@26:24> : [-1..]
   }

   fn sum(var ls: List[[0..]]) -> [0..] {
      var s = 0;
      while ls is Cons {
         s += ls.head;
         ls = ls.tail;
      };
      return s;
   }

   fn sum_bad(var ls: List[[..1000]]) -> [0..] {
      var s = 0;
      while ls is Cons {    //> E : inferred incorrect type [0..] for variable s at loop body start, please provide a type annotation at variable declaration site
         s += ls.head;
         ls = ls.tail;
      };
      return s;
   }

   fn reverse[T](var ls: List[T]) -> List[T] {
      var reversed = new Nil();
      while ls is Cons {
         reversed = new Cons(head = ls.head, tail = reversed);
         ls = ls.tail;
      };
      return reversed;
   }

   fn filterLessOrEq(a: Int, var ls: List[Int]) -> List[[..a]] {
      var filteredReversed = new Nil();
      while ls is Cons {
         if ls.head <= a {
            filteredReversed = new Cons(head = ls.head, tail = filteredReversed);
         };
         ls = ls.tail;
      };
      return reverse(filteredReversed);
   }

   fn filterLessThan(a: Int, var ls: List[Int]) -> List[[..<a]] {
      var filteredReversed = new Nil();
      while ls is Cons {
         if ls.head < a {
            filteredReversed = new Cons(head = ls.head, tail = filteredReversed);
         };
         ls = ls.tail;
      };
      return reverse(filteredReversed);
   }

   fn filterLessThan_bad1(a: Int, var ls: List[Int]) -> List[[..<a]] {
      var filteredReversed = new Nil();
      while ls is Cons {
         if ls.head <= a {
            filteredReversed = new Cons(head = ls.head, tail = filteredReversed);   //> E : initialization of field head: expected [..<a], found ls<loop-body-start@84:24>.head : [..a]
         };
         ls = ls.tail;
      };
      return reverse(filteredReversed);
   }

   fn filterLessThan_bad2(a: Int, var ls: List[Int]) -> List[[..<a]] {
      var filteredReversed: List[[..<a]] = new Nil();
      while ls is Cons {
         if ls.head <= a {
            filteredReversed = new Cons(head = ls.head, tail = filteredReversed);   //> E : initialization of field head: expected [..<a], found ls<loop-body-start@95:24>.head : [..a]
         };
         ls = ls.tail;
      };
      return reverse(filteredReversed);
   }

   fn filter[T](var ls: List[T], p: pure fn (T) -> Bool) -> List[T with p(it)] {
      var filteredReversed = new Nil();
      while ls is Cons {
         if p(ls.head) {
            filteredReversed = new Cons(head = ls.head, tail = filteredReversed);
         };
         ls = ls.tail;
      };
      return reverse(filteredReversed);
   }

   fn filter_bad[T](var ls: List[T], p: pure fn (T) -> Bool) -> List[T with p(it)] {
      var filteredReversed = new Nil();
      while ls is Cons {
         if !p(ls.head) {
            filteredReversed = new Cons(head = ls.head, tail = filteredReversed);   //> E : initialization of field head: expected T with p(it), found ls<loop-body-start@117:24>.head : T with !p(it)
         };
         ls = ls.tail;
      };
      return reverse(filteredReversed);
   }

   fn filterLessThanSimpler(a: Int, ls: List[Int]) -> List[[..a-1]] =
      filter(ls, fn (x) -> x < a)

   fn filterLessThanSimpler_bad(a: Int, ls: List[Int]) -> List[[..a-1]] =
      filter(ls, fn (x) -> x <= a)  //> E : return value: expected lists.List[[..<a]], found lists.List[[..a]]

   fn isSingletonList[T](ls: List[T]) -> Bool =
      ls is Cons && ls.tail is Nil

   fn zip[S, T](ls1: List[S], ls2: List[T] where length(ls1) == length(ls2)) -> List[Pair[S, T]] {
      var rem1 = ls1;
      var rem2 = ls2;
      var reversedZip = new Nil();
      while rem1 is Cons && rem2 is Cons {
         reversedZip = new Cons(head = new Pair(l = rem1.head, r = rem2.head), tail = reversedZip);
         rem1 = rem1.tail;
         rem2 = rem2.tail;
      };
      return reverse(reversedZip);
   }

}

object UseLists {

   fn useZipCorrectly1(integers: List[Int], strings: List[String] where length(integers) == length(strings)) -> List[Pair[Int, String]] {
      return zip(integers, strings);
   }

   fn useZipCorrectly2(integers: List[Int], strings: List[String]) -> List[Pair[Int, String]] =
      when length(integers) == length(strings)
      then zip(integers, strings)
      else new Nil()

   fn useZipCorrectly3(integers: List[Int], strings: List[String]) -> List[Pair[Int, String]] =
      when length(integers) != length(strings)
      then new Nil()
      else zip(integers, strings)

   fn useZipIncorrectly(integers: List[Int], strings: List[String]) -> List[Pair[Int, String]] {
      return zip(integers, strings);     //> E : illegal call to zip: I cannot prove that its precondition lists.Lists.length(integers) == lists.Lists.length(strings) holds
   }

   fn instanceTests(ls: List[I], thres: Int) {
      val filtered = filter(ls, fn (x) -> x is A && x.value() >= thres);
      filtered : Nothing;   //> E : type ascription: expected Nothing, found filtered : lists.List[lists.A with thres <= it.value()]
   }

}

interface I
class A : I {
   pure fn value(this) -> Int = 42
}
