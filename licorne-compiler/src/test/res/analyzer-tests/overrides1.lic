
interface Producer[+T, -A] {
   fn produce(arg: A) -> T
}

class DogProducer : Producer[Animal, Int] {
    fn produce(name: String) -> Dog {      //> E : type mismatch on parameter name of method produce(#1): erased type is licorne.core.String but should be Int since the method overrides produce(#1) in Producer[Animal,Int]
        return new Dog(name);
    }
}

interface Animal
class Dog(name: String) : Animal {
   fn name() -> String {
      return this.name;
   }
}
