
object Main {

    fn main() {
        // see the corresponding test in ExecutionTests for cases that work
        Foo(0, 1, 2)         //> E : method constructor(#3) not found in type Foo::companion
        Bar(0)               // OK
        Bar(0, 1)            // OK
        Bar(0, 1, 2)         // OK
        Bar(0, 1, 2, 3)      //> E : method constructor(#4) not found in type Bar::companion
        Baz(0, 1)            //> E : method constructor(#2) not found in type Baz::companion

        val f = Foo(1)
        f : Nothing              //> E : type ascription: expected Nothing, found f : Foo with it.a() == 1 && it.b() == 2
    }

}

record Foo(a: Int, b: [a..] = a + 1)
record Bar(a: Int, b: Int = 2*a + 5, c: Int = 0)
record Baz(a: Int, b: Int = 2*a + 5, c: Int)
