
object Test {

   fun foo(a: Int, b: [0..9]){}
   fun bar(i: I with it.m(), a: A){}

   fun test1_wrong(x: Int, y: Int) {
      foo(x, y)      //> E : second argument of call to foo: expected [0..9], found y : Int
   }

   fun test1_ok(x: Int, y: Int) {
      foo(x, y!!)    // OK
   }

   fun test2_wrong(x: Int?) {
      foo(x, 0)      //> E : first argument of call to foo: expected Int, found x : Int?
   }

   fun test2_ok(x: Int?) {
      foo(x!!, 0)    // OK
   }

   fun test3_wrong(i: I) {
      bar(i, A())         //> E : first argument of call to bar: expected I with it.m(), found i : I
   }

   fun test3_ok(i: I) {
      bar(i!!, A())       // OK
   }

}

interface I {
   pure fun m(): Boolean
}

class A : I {
   pure fun m(): Boolean = false
}
