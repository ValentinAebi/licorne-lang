package lists

typealias Length = [0..]

datatype List[+T] {

   pure fun length() -> Length

   fun isSingletonList(this) -> Bool     //> W : receiver parameter can be omitted

   fun length_bad() -> Length {
      var len = -1
      var ls = this
      while (ls is Cons) {
         len += 1
         ls = ls.tail()
      }
      return len //> E : return value: expected lists.Length, found len : [-1..]
   }

   fun reverse() -> List[T] {
      var reversed = Nil()
      var ls = this
      while (ls is Cons) {
         reversed = Cons(ls.head(), reversed)
         ls = ls.tail()
      }
      return reversed
   }

   fun filter(p: pure (T) -> Bool) -> List[T with p(it)] {
      var filteredReversed = Nil()
      var ls = this
      while (ls is Cons) {
         if (p(ls.head())) {
            filteredReversed = Cons(ls.head(), filteredReversed)
         }
         ls = ls.tail()
      }
      return filteredReversed.reverse()
   }

   fun filter_bad(p: pure (T) -> Bool) -> List[T with p(it)] {
      var filteredReversed = Nil()
      var ls = this
      while (ls is Cons) {
         if (!p(ls.head())) {
            filteredReversed = Cons(ls.head(), filteredReversed) //> E : first argument of call to constructor: expected T with p(it), found ls.head() : T with !p(it)
         }
         ls = ls.tail()
      }
      return filteredReversed.reverse()
   }

   fun zip[S](other: List[S] where this.length() == other.length()) -> List[Pair[T, S]] {
      var rem1 = this
      var rem2 = other
      var reversedZip = Nil()
      while (rem1 is Cons && rem2 is Cons) {
         reversedZip = Cons(Pair(rem1.head(), rem2.head()), reversedZip)
         rem1 = rem1.tail()
         rem2 = rem2.tail()
      }
      return reversedZip.reverse()
   }

}

record Nil : List[Nothing] {
    pure fun length() -> [0..0] = 0
    fun isSingletonList() -> Bool = false
}

record Cons[+T](head: T, tail: List[T]) : List[T] {
    pure fun length() -> [1..] = 1 + tail.length()
    fun isSingletonList() -> Bool = tail is Nil
}

record Pair[+L, +R](l: L, r: R)

object UseLists {

   fun useZipCorrectly1(integers: List[Int], strings: List[String] where integers.length() == strings.length()) -> List[Pair[Int, String]] {
      return integers.zip(strings)
   }

   fun useZipCorrectly2(integers: List[Int], strings: List[String]) -> List[Pair[Int, String]] =
      if (integers.length() == strings.length()) integers.zip(strings)
      else Nil()

   fun useZipCorrectly3(integers: List[Int], strings: List[String]) -> List[Pair[Int, String]] =
      if (integers.length() != strings.length()) Nil()
      else integers.zip(strings)

   fun useZipIncorrectly(integers: List[Int], strings: List[String]) -> List[Pair[Int, String]] {
      return integers.zip(strings)   //> E : illegal call to zip: I cannot prove that its precondition integers.length() == strings.length() holds
   }

   fun instanceTests(ls: List[I], thres: Int) {
      val filtered = ls.filter({ x -> x is A && x.value() >= thres })
      filtered : Nothing //> E : type ascription: expected Nothing, found filtered : lists.List[lists.A with thres <= it.value()] (where I am unable to prove the stability of the following values: it.value())
   }

}

interface I
class A : I {
   pure fun value() -> Int = 42
}
