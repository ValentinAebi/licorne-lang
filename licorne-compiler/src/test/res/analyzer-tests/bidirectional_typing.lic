
class MutableStack[T] {

   fn push(this, t: T) {
      panic "not implemented"
   }

   fn pop(this) -> T {
      panic "not implemented"
   }

}

object Test {

   fn m1() {
      val stack = new MutableStack();
      stack.push(42);           // OK, resolve the type variable to Int
      stack.push("Hi");         //> E : first argument of call to push: expected Int, found "Hi" : String
   }

   fn m2() {
      val stack = new MutableStack[String]();
      stack.push(42);           //> E : first argument of call to push: expected String, found 42
      stack.push("Hi");         // OK
   }

   fn m3(x: Int) -> [0..] {
      val stack = new MutableStack();
      stack.push(when x >= 0 then x else null);
      return stack.pop();       //> E : return value: expected [0..], found [0..]?
   }

}
