// adapted from the Java Checker Framework manual: https://checkerframework.org/manual/#index-checker

object Client {

    fun clearIndex1[T](a: ArrayWrapper[T?], i: Idx(a)) {
        a.set(i, null)
    }

    fun clearIndex2[T](a: ArrayWrapper[T?], i: Int) {
        if (0 <= i && i < a.size()) {
            a.set(i, null)
        }
    }

}

class ArrayWrapper[T] (
    public size: Length,
    val wrapped: Array[T] with it.size() == size
) : Sized {

    fun set(i: Idx(this), elem: T) {
        this.wrapped.set(i, elem)
    }

    fun get(i: Idx(this)) -> T {
        return this.wrapped.at(i)
    }

}

object ArrayWrappers {

    fun mkNew[T](size: Length) -> ArrayWrapper[T] {
        val wrapped = Array(size)
        return ArrayWrapper(size, wrapped)
    }

}

interface Sized {
    pure fun size() -> Length
}

typealias Length = [0..]
typealias Idx(seq: Sized) = [0 ..< seq.size()]

class Array[T](public size: Length) : Sized {

    fun at(i: Idx(this)) -> T {
        panic "compile to bytecode xALOAD"
    }

    fun set(i: Idx(this), t: T) {
        panic "compile to bytecode xASTORE"
    }

}
