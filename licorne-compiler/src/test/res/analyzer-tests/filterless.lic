import Lists.*


object FilterLess {

    fn filterLessThan_adHoc_correct(a: Int, var ls: List[Int]) -> List[[..<a]] {
        var filteredReversed = Nil()
        while (ls is Cons) {
            if (ls.first() < a) {
                filteredReversed = Cons(ls.first(), filteredReversed)
            }
            ls = ls.rest()
        }
        return reverse(filteredReversed)
    }

    fn filterLessThan_adHoc_buggy(a: Int, var ls: List[Int]) -> List[[..<a]] {
        var filteredReversed = Nil()
        while (ls is Cons) {
            if (ls.first() <= a) {  // ERROR: should be <
                filteredReversed = Cons(ls.first(), filteredReversed)   //> E : first argument of call to constructor: expected [..<a], found ls.first() : [..a]
            }
            ls = ls.rest()
        }
        return reverse(filteredReversed)
    }

    fn filterLessThan_functional_correct(a: Int, ls: List[Int]) -> List[[..<a]] =
        filter(ls) { it < a }

    fn filterLessThan_functional_buggy(a: Int, ls: List[Int]) -> List[[..<a]] =
        filter(ls) { it <= a }  // ERROR: should be elem < a    //> E : return value: expected List[[..<a]], found List[[..a]]

}

datatype List[+T]
record Cons[+T](first: T, rest: List[T]) : List[T]
record Nil() : List[Nothing]

object Lists {

    fn map[T, U](ls: List[T], f: (T) -> U) -> List[U] {
        var resultReversed = Nil()
        for (var rem = ls; rem is Cons; rem = rem.rest()) {
            resultReversed = Cons(f(rem.first()), resultReversed)
        }
        return reverse(resultReversed)
    }

    fn filter[T](ls: List[T], p: pure (T) -> Bool) -> List[T with p(it)] {
        var filteredReversed = Nil()
        for (var rem = ls; rem is Cons; rem = rem.rest()) {
            if (p(rem.first())) {
                filteredReversed = Cons(rem.first(), filteredReversed)
            }
        }
        return reverse(filteredReversed)
    }

    fn reverse[T](ls: List[T]) -> List[T] {
        var rev = Nil()
        for (var rem = ls; rem is Cons; rem = rem.rest()) {
            rev = Cons(rem.first(), rev)
        }
        return rev
    }

}
