import Lists.*;


object FilterLess {

    fn filterLessThan_adHoc_correct(a: Int, var ls: List[Int]) -> List[[..<a]] {
        var filteredReversed = new Nil();
        while ls is Cons {
            if ls.first() < a {
                filteredReversed = new Cons(first = ls.first(), rest = filteredReversed);
            };
            ls = ls.rest();
        };
        return reverse(filteredReversed);
    }

    fn filterLessThan_adHoc_buggy(a: Int, var ls: List[Int]) -> List[[..<a]] {
        var filteredReversed = new Nil();
        while ls is Cons {
            if ls.first() <= a {  // ERROR: should be <
                filteredReversed = new Cons(first = ls.first(), rest = filteredReversed);   //> E : initialization of field first: expected [..<a], found ls.first() : [..a]
            };
            ls = ls.rest();
        };
        return reverse(filteredReversed);
    }

    fn filterLessThan_functional_correct(a: Int, ls: List[Int]) -> List[[..<a]] =
        filter(ls, fn (elem) -> elem < a)

    fn filterLessThan_functional_buggy(a: Int, ls: List[Int]) -> List[[..<a]] =
        filter(ls, fn (elem) -> elem <= a)  // ERROR: should be elem < a    //> E : return value: expected List[[..<a]], found List[[..a]]

}

datatype List[+T]
record Cons[+T](first: T, rest: List[T]) : List[T]
record Nil() : List[Nothing]

object Lists {

    fn map[T, U](ls: List[T], f: fn (T) -> U) -> List[U] {
        var resultReversed = new Nil();
        for var rem = ls; rem is Cons; rem = rem.rest() {
            resultReversed = new Cons(first = f(rem.first()), rest = resultReversed);
        };
        return reverse(resultReversed);
    }

    fn filter[T](ls: List[T], p: pure fn (T) -> Bool) -> List[T with p(it)] {
        var filteredReversed = new Nil();
        for var rem = ls; rem is Cons; rem = rem.rest() {
            if p(rem.first()) {
                filteredReversed = new Cons(first = rem.first(), rest = filteredReversed);
            }
        };
        return reverse(filteredReversed);
    }

    fn reverse[T](ls: List[T]) -> List[T] {
        var rev = new Nil();
        for var rem = ls; rem is Cons; rem = rem.rest() {
            rev = new Cons(first = rem.first(), rest = rev);
        };
        return rev;
    }

}
