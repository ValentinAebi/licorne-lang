import Lists.*


object FilterLess {

    fun filterLessThan_adHoc_correct(a: Int, var ls: List[Int]): List[[..<a]] {
        var filteredReversed = Nil()
        while (ls is Cons) {
            if (ls.first() < a) {
                filteredReversed = Cons(ls.first(), filteredReversed)
            }
            ls = ls.rest()
        }
        return reverse(filteredReversed)
    }

    fun filterLessThan_adHoc_buggy(a: Int, var ls: List[Int]): List[[..<a]] {
        var filteredReversed = Nil()
        while (ls is Cons) {
            if (ls.first() <= a) {  // ERROR: should be <
                filteredReversed = Cons(ls.first(), filteredReversed)   //> E : first argument of call to constructor: expected [..<a], found ls.first() : [..a]
            }
            ls = ls.rest()
        }
        return reverse(filteredReversed)
    }

    fun filterLessThan_functional_correct(a: Int, ls: List[Int]): List[[..<a]] =
        filter(ls) { it < a }

    fun filterLessThan_functional_buggy(a: Int, ls: List[Int]): List[[..<a]] =
        filter(ls) { it <= a }  // ERROR: should be elem < a    //> E : return value: expected List[[..<a]], found List[[..a]]

}

sealed interface List[out T]
data class Cons[out T](val first: T, val rest: List[T]) : List[T]
data class Nil() : List[Nothing]

object Lists {

    fun map[T, U](ls: List[T], f: (T) -> U): List[U] {
        var resultReversed = Nil()
        for (var rem = ls; rem is Cons; rem = rem.rest()) {
            resultReversed = Cons(f(rem.first()), resultReversed)
        }
        return reverse(resultReversed)
    }

    fun filter[T](ls: List[T], p: pure (T) -> Boolean): List[T with p(it)] {
        var filteredReversed = Nil()
        for (var rem = ls; rem is Cons; rem = rem.rest()) {
            if (p(rem.first())) {
                filteredReversed = Cons(rem.first(), filteredReversed)
            }
        }
        return reverse(filteredReversed)
    }

    fun reverse[T](ls: List[T]): List[T] {
        var rev = Nil()
        for (var rem = ls; rem is Cons; rem = rem.rest()) {
            rev = Cons(rem.first(), rev)
        }
        return rev
    }

}
