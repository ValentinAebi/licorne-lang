// adapted from the Java Checker Framework manual: https://checkerframework.org/manual/#index-checker

import StringOpsPlaceholder.*;


typealias Length = [0..]

object IC7 {

    fn removeSubstring_correct_1(original: String, removed: String) -> String {
        val i = indexOf(original, removed);
        if (i != -1) {    // checking using !=
            return concat(
                substring(original, 0, i),
                substring(original, i + length(removed), length(original))
            );
        };
        return original;
    }

    fn removeSubstring_correct_2(original: String, removed: String) -> String {
        val i = indexOf(original, removed);
        if (i > -1) {      // <- checking using >
            return concat(
                substring(original, 0, i),
                substring(original, i + length(removed), length(original))
            );
        };
        return original;
    }

    fn removeSubstring_buggy(original: String, removed: String) -> String {
        val i = indexOf(original, removed);
        // ERROR: missing check for i == -1
        return concat(
            substring(original, 0, i),  //> E : third argument of call to substring: expected Position(original) & [0..], found i : [-1 ..< StringOpsPlaceholder.length(original) - StringOpsPlaceholder.length(removed)]
            substring(original, i + length(removed), length(original))  //> E : second argument of call to substring: expected Position(original), found i + StringOpsPlaceholder.length(removed) : [-1..]
        );
    }

    // alternative using explicit precondition
    fn removeSubstring_precond(original: String, removed: String) -> String {
        val i = indexOf(original, removed);
        if (i != -1) {
            return concat(
                substring(original, 0, i),
                substring(original, i + length(removed), length(original))
            );
        };
        return original;
    }

}

typealias Position(s: String) = [0 .. length(s)]
typealias StringOfLen(len: Length) = String with length(it) == len

object StringOpsPlaceholder {

    pure fn length(s: String) -> Length {
        panic "not implemented"
    }

    fn indexOf(s: String, target: String) -> [-1 ..< length(s) - length(target)] {
        panic "not implemented"
    }

    fn substring(s: String, from: Position(s), end: Position(s) & [from..]) -> StringOfLen(end - from) {
        panic "not implemented"
    }

    fn concat(s1: String, s2: String) -> StringOfLen(length(s1) + length(s2)) {
        panic "not implemented"
    }

}


