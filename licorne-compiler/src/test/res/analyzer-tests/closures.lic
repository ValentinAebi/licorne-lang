
object Test {

   fn test(animal: Animal) {

      ifDog[Unit](animal) { dog -> dog.woof() }
      ifDog[Unit](animal) { dog: Dog -> dog.woof() }
      ifDog[Unit](animal) { dog -> dog.eat(Kibbles()) } // OK, drop return value of eat
      ifDog[Bool](animal) { dog -> dog.isHungry() }
      ifDogOrElse(animal, 0) { dog -> dog.woof() }         //> E : return value: expected Int, found Unit
      ifDogOrElse(animal, 0) { dog -> 42 }                 // OK
      ifDogOrElse(animal, 0) { 42 }                        // OK

      ifDogOrElse(animal, 0, { panic "test..." })          // OK
      ifDogOrElse(animal, 0) { panic "test..." }           // OK

      ifDogOrElse(animal, unit) { dog -> dog.woof() }      // OK
      ifDogOrElse(animal, unit) { it.woof() }              // OK
      ifDogOrElse(animal, unit) { dog -> dog }             // OK
      ifDogOrElse(animal, unit) { it }                     // OK

      var x = 0
      ifDogOrElse(animal, "Hi", { dog ->
        x += 1
        return x                         //> E : return value: expected licorne.core.String, found Int
      })
      ifDogOrElse(animal, "Hi", {
        x += 1
        return x                         //> E : return value: expected licorne.core.String, found Int
      })

   }

   private fn ifDog[T](animal: Animal, action: (Dog) -> T) {
      if (animal is Dog) {
         action(animal)
      }
   }

   private fn ifDogOrElse[T](animal: Animal, default: T, f: (Dog) -> T) -> T =
      if (animal is Dog) f(animal)
      else default

}

interface Animal

class Dog : Animal {

   fn woof() {}

   fn isHungry() -> Bool {
      return true
   }

   // returns true iff not hungry anymore
   fn eat(food: Food) -> Bool {
      // ...
      return false
   }

}

interface Food
class Kibbles : Food
