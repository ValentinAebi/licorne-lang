import Dates.nDaysInMonth;


typealias Year = Int
typealias Month = [1..12]
typealias DayOfMonth(year: Year, month: Month) = [1..nDaysInMonth(year, month)]

record Date(year: Year, month: Month, day: DayOfMonth(year, month)) {

    pure fn nextDay(this) -> Date {
        if (this.day() < nDaysInMonth(this.year(), this.month())) {
            return new Date(year = this.year(), month = this.month(), day = this.day() + 1);
        } else if (this.month() < 12) {
            return new Date(year = this.year(), month = this.month() + 1, day = 1);
        } else {
            return new Date(year = this.year() + 1, month = 1, day = 1);
        }
    }

    pure fn previousDay(this) -> Date {
        if (this.day() > 1) {
            return new Date(year = this.year(), month = this.month(), day = this.day() - 1);
        } else if (this.month() > 1) {
            // ERROR: the programmer forgot to update `this.month() + 1` to `this.month() - 1` after copy-pasting from nextDay
            return new Date(year = this.year(), month = this.month() + 1, day = nDaysInMonth(this.year(), this.month() - 1));   //> E : initialization of field month: expected Month, found this.month() + 1 : [3..] <//> E : initialization of field day: expected DayOfMonth(this.year(),this.month() + 1), found Dates.nDaysInMonth(this.year(),this.month() - 1) : [28..31]
        } else {
            return new Date(year = this.year() - 1, month = 12, day = nDaysInMonth(this.year() - 1, 12));
        }
    }

}


object Dates {

    pure fn nDaysInMonth(year: Year, month: Month) -> [28..31] {
        if (month == 2) {
            // slightly simplified...
            return when year % 4 != 0 then 28
                   else when year % 100 != 0 then 29
                   else when year % 400 != 0 then 28
                   else 29;
        };
        if (month == 1 || month == 3 || month == 5 || month == 7 || month == 8 || month == 10 || month == 12) {
            return 31;
        };
        return 30;
    }

}

typealias Hours = [0..23]
typealias Minutes = [0..59]
typealias Seconds = [0..59]


record Time(hours: Hours, minutes: Minutes, seconds: Seconds) {

    fn deltaTime(this, h: Int, min: Int, sec: Int) -> Time {
        val sSum = seconds() + sec;
        val seconds = (sSum % 60 + 60) % 60;
        val mSum = minutes() + min + (sSum - seconds) / 60;
        val minutes = (mSum % 60 + 60) % 60;
        val hSum = hours() + h + (mSum - minutes) / 60;
        val hours = (hSum % 24 + 24) % 24;
        return new Time(hours, minutes, seconds);
    }

    fn deltaHours(this, h: Int) -> Time = deltaTime(h, 0, 0)

    fn deltaMinutes(this, m: Int) -> Time = deltaTime(0, m, 0)

    fn deltaSeconds(this, s: Int) -> Time = deltaTime(0, 0, s)

}


class MutTime(
    var hours: Hours,
    var minutes: Minutes,
    var seconds: Seconds
) {

    fn moveBy(this, h: Int, m: Int, s: Int) {
        val sSum = this.seconds + s;
        this.seconds = (sSum % 60 + 60) % 60;
        val mSum = this.minutes + m + (sSum / 60);
        this.minutes = (mSum % 60 + 60) % 60;
        val hSum = this.hours + h + (mSum / 60);
        // ERROR: should be normalized to 24, not 60
        this.hours = (hSum % 60 + 60) % 60;     //> E : assignment to field hours: expected Hours, found (hSum % 60 + 60) % 60 : [0..59]
    }

    fn moveByHours(this, h: Int) {
        moveBy(h, 0, 0);
    }

    fn moveByMinutes(this, m: Int) {
        moveBy(0, m, 0);
    }

    fn moveBySeconds(this, s: Int) {
        moveBy(0, 0, s);
    }

}

