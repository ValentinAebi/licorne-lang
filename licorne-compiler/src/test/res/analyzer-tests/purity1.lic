
interface I {
   pure fn foo(i: Int) -> String
   fn bar(s: String) -> Int
}

class A : I {

   pure fn foo(i: Int) -> String {
      panic "not implemented"
   }

   fn bar(s: String) -> Int {
      panic "not implemented"
   }

}

object B : I {

   fn foo(i: Int) -> String {   //> E : foo(#1) in B overrides foo(#1) in I but violates its declared purity
      panic "not implemented"
   }

   pure fn bar(s: String) -> Int {
      panic "not implemented"
   }

}
