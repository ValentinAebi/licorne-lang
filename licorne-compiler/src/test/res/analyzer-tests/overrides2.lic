
typealias Plants = List[Plant]

interface Seq[+T]
interface List[+T] : Seq[T]
class MutList[E] : List[E]

interface Animal
class Dog(name: String) : Animal

interface Plant
class Flower : Plant

interface AnimalMaker {
   fn mkAnimals() -> Seq[Animal]
   fn mkAnimalsFood1() -> Plants
   fn mkAnimalsFood2() -> Plants
}

interface DogMaker : AnimalMaker {
    fn mkAnimals() -> MutList[Dog]
    fn mkAnimalsFood1() -> List[Animal]    //> E : return type of method mkAnimalsFood1(#0) that overrides mkAnimalsFood1(#0) in AnimalMaker: expected Plants, found List[Animal]
    fn mkAnimalsFood2() -> List[Flower]
}
