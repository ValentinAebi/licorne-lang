
typealias Plants = List[Plant]

interface Seq[out T]
interface List[out T] : Seq[T]
class MutList[E] : List[E]

interface Animal
class Dog(name: String) : Animal

interface Plant
class Flower : Plant

interface AnimalMaker {
   fun mkAnimals(): Seq[Animal]
   fun mkAnimalsFood1(): Plants
   fun mkAnimalsFood2(): Plants
}

interface DogMaker : AnimalMaker {
    fun mkAnimals(): MutList[Dog]
    fun mkAnimalsFood1(): List[Animal]    //> E : return type of method mkAnimalsFood1(#0) that overrides mkAnimalsFood1(#0) in AnimalMaker: expected Plants, found List[Animal]
    fun mkAnimalsFood2(): List[Flower]
}
