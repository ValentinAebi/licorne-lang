
object Test {

    fn test1(arr: Array[String]) {
        var i = arr.length();
        while i >= 0 {
            print(arr.get(i));  //> E : first argument of call to get: expected Idx[T](arr), found i : [0 .. arr.length()]
            if i % 2 == 0 {
                i -= 1;
            } else {
                i -= 2;
            };
        }
    }

    fn test2(arr: Array[String]) {
        var i = arr.length() - 1;
        while i >= 0 {
            print(arr.get(i));
            if i % 2 == 0 {
                i -= 1;
            } else {
                i -= 2;
            };
        }
    }

    fn print(o: Any) {
        panic "not implemented"
    }

}

typealias Length = [0..]
typealias Idx[T](a: Array[T]) = [0 ..< a.length()]

class Array[T](public length: [0..]) {

    fn get(this, i: Idx(this)) {
        panic "compile to bytecode xALOAD";
    }

}
