
datatype D {
    open fn d1(i: Int) -> Int     //> E : open method d1 must have a body
    open fn d2(i: Int) -> Int {}  // OK
    fn d3(i: Int) -> Int          // OK
}

class A {
    open fn a1(i: Int) -> Int     //> E : method a1 defined in non abstract type A cannot be open
    fn a2(i: Int) -> Int {}       // OK
    fn a3(i: Int) -> Int          //> E : method a3 defined in non abstract type A must have a body
}
