package checker_framework_examples;

import checker_framework_examples.StringOpsPlaceholder.*;


object Ex_11_7 {

    fn removeSubstring(original: String, removed: String) -> String {
        val i = indexOf(original, removed);
        if (i != -1) {
            return concat(
                substring(original, 0, i),
                substring(original, i + length(removed), length(original))
            );
        };
        return original;
    }

    fn removeSubstring_bad(original: String, removed: String) -> String {
        val i = indexOf(original, removed);
        if (i != -1) {
            return concat(
                substring(original, 0, i),
                // error here: i + length(original) instead of i + length(removed)
                // TODO improve error messages
                substring(original, i + length(original), length(original))     //> E : second argument of call to substring: expected checker_framework_examples.Position(original), found i + checker_framework_examples.StringOpsPlaceholder.length(original) : [0..] <//> E : illegal call to substring: I cannot prove that its precondition i + checker_framework_examples.StringOpsPlaceholder.length(original) <= checker_framework_examples.StringOpsPlaceholder.length(original) holds
            );
        };
        return original;
    }

}

typealias Position(s: String) = [0 .. length(s)]

object StringOpsPlaceholder {

    pure fn length(s: String) -> [0..] {
        panic "not implemented"
    }

    fn indexOf(s: String, target: String) -> [-1 ..< length(s) - length(target)] {
        panic "not implemented"
    }

    fn substring(s: String, from: Position(s), end: Position(s) where from <= end) -> String with length(it) == end - from {
        panic "not implemented"
    }

    fn concat(s1: String, s2: String) -> String with length(it) == length(s1) + length(s2) {
        panic "not implemented"
    }

}
