
datatype List[+T]
record Cons[+T](head: T, tail: List[T]) : List[T]
record Nil : List[Nothing]

object Lists {

   fn length[A](var ls: List[A]) -> Int {
      var len = 0;
      while ls is Cons {
         len += 1;
         ls = ls.tail();
      };
      return ls.head();   //> E : method head not found in type Nil
   }

   fn tail[U](ls: List[U]) -> List[U] =
      when ls is Cons
         then ls.tail()
         else panic "empty list"

}
