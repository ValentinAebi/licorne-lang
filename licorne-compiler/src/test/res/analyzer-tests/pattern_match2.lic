
datatype List[out T]
record Cons[out T](head: T, tail: List[T]) : List[T]
record Nil : List[Nothing]

object Lists {

   fun length[A](var ls: List[A]): Int {
      var len = 0
      while (ls is Cons) {
         len += 1
         ls = ls.tail()
      }
      return ls.head() //> E : method head(#0) not found in type Nil
   }

   fun tail[U](ls: List[U]): List[U] =
      if (ls is Cons) ls.tail()
      else panic "empty list"

}
