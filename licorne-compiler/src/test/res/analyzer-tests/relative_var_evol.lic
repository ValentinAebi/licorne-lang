
object Test {

    fun test(t: [0..]) {
        var a = 0
        var b = 0
        while (a < t) {
            foo(a, b)// OK
            bar(a, b)//> E : illegal call to bar: I cannot prove that its precondition a + 1 <= b holds
            a += 1
            b += 2
            foo(a, b)// OK
        }
    }

    private fun foo(x: Int, y: Int where x <= y) {}
    private fun bar(x: Int, y: Int where x < y) {}

}
