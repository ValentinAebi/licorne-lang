
interface Seq[+T] {
   fn filter(pred: pure (T) -> Bool) -> Seq[T with pred(it)]
}

object Test {

   fn filterInRange(seq: Seq[Int], u: Int) -> Seq[[0..u]] =
      seq.filter { x -> 0 <= x && x <= u }                // OK

   fn filterInRange_bad(seq: Seq[Int], u: Int) -> Nothing =
      seq.filter { x -> 0 <= x && x <= u }                //> E : return value: expected Nothing, found Seq[[0..u]]

   fn keepAs(seq: Seq[I]) -> Seq[A] =
      seq.filter { i -> i is A }                          // OK

   fn keepAs_bad(seq: Seq[I]) -> Nothing =
      seq.filter { i -> i is A }                          //> E : return value: expected Nothing, found Seq[A]

   fn filterNonNull[T](seq: Seq[T?]) -> Seq[T] =
      seq.filter { e -> e != null }                       // OK

   fn filterNonNull_bad[T](seq: Seq[T?]) -> Nothing =
      seq.filter { e -> e != null }                       //> E : return value: expected Nothing, found Seq[T]

}

interface I
class A : I
class B : I
