
interface Seq[out T] {
   fun filter(pred: pure (T) -> Boolean): Seq[T with pred(it)]
}

object Test {

   fun filterInRange(seq: Seq[Int], u: Int): Seq[[0..u]] =
      seq.filter { x -> 0 <= x && x <= u }                // OK

   fun filterInRange_bad(seq: Seq[Int], u: Int): Nothing =
      seq.filter { x -> 0 <= x && x <= u }                //> E : return value: expected Nothing, found Seq[[0..u]]

   fun keepAs(seq: Seq[I]): Seq[A] =
      seq.filter { i -> i is A }                          // OK

   fun keepAs_bad(seq: Seq[I]): Nothing =
      seq.filter { i -> i is A }                          //> E : return value: expected Nothing, found Seq[A]

   fun filterNonNull[T](seq: Seq[T?]): Seq[T] =
      seq.filter { e -> e != null }                       // OK

   fun filterNonNull_bad[T](seq: Seq[T?]): Nothing =
      seq.filter { e -> e != null }                       //> E : return value: expected Nothing, found Seq[T]

}

interface I
class A : I
class B : I
