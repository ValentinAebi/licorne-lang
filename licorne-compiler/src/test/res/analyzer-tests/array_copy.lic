
// IMPORTANT: in case this test fails for no apparent reason, remember to check if the fact that array.length() in the
// typealias definition refers to Seq.length rather than Array.length might be the cause of the issue

typealias Length = [0..]
typealias Idx[T](array: Seq[T]) = [0 ..< array.length()]

interface Seq[T] {
   pure fun length(): Length
}

class Array[T](public length: Length) : Seq[T] {

   fun at(i: Idx(this)): T {
      panic "not implemented"
   }

   fun set(i: Idx(this), value: T) {
      panic "not implemented"
   }
}

object ArrayCopy {

   fun copy1[T](xs: Array[T]): Array[T] {
      val length = xs.length()
      val copy = Array(length)
      for (var i = 0; i < length; i += 1) {
         val t = xs.at(i)
         copy.set(i, t)
      }
      return copy
   }

   fun copy2[T](xs: Array[T]): Array[T] {
      val copy = Array(xs.length())
      for (var i = 0; i < xs.length(); i += 1) {
         val t = xs.at(i)
         copy.set(i, t)
      }
      return copy
   }

   fun copy3[T](xs: Array[T]): Array[T] {
      val copy = Array(xs.length())
      for (var i = 0; i < copy.length(); i += 1) {
         val t = xs.at(i)
         copy.set(i, t)
      }
      return copy
   }

   fun copyWrong[T](xs: Array[T]): Array[T] {
      val copy = Array(xs.length() / 2)
      for (var i = 0; i < xs.length(); i += 1) {
         val t = xs.at(i)
         copy.set(i, t)  //> E : first argument of call to set: expected Idx[T](copy), found i : [0 ..< xs.length()]
      }
      return copy
   }

   fun copyOversized[T](xs: Array[T]): Array[T] {
      val copy = Array(xs.length() + 100)
      for (var i = 0; i < xs.length(); i += 1) {
         val t = xs.at(i)
         copy.set(i, t)
      }
      return copy
   }

}
