
typealias Length = [0..]
typealias Idx[T](seq: Seq[T]) = [0 ..< seq.size()]

interface Seq[T] {
   pure fn size(this) -> Length

   fn at(this, i: Idx(this)) -> T
}

object SeqTraversal {

   fn sum(seq: Seq[Int]) -> Int {
      var s = 0;
      for var i = 0; i < seq.size(); i += 1 {
         s += seq.at(i);    // OK
      };
      return s;
   }

   fn sum_wrong(seq: Seq[Int]) -> Int {
      var s = 0;
      for var i = 0; i <= seq.size(); i += 1 {
         s += seq.at(i);    //> E : first argument of call to at: expected Idx[T](seq), found i<loop-body-start@23:7> : [0 .. seq.size()]
      };
      return s;
   }

}
