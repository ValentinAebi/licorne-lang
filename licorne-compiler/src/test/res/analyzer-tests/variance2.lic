
interface Covariant[+T] {
   fn accept(t: T)            //> E : variance error: covariant type parameter T in contravariant position
   fn produce() -> T
}

interface Contravariant[-T] {
   fn accept(t: T)
   fn produce() -> T            //> E : variance error: contravariant type parameter T in covariant position
}

interface Invariant[T] {
   fn accept(t: T)
   fn produce() -> T
}
