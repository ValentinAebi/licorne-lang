
interface Covariant[+T] {
   fun accept(t: T)            //> E : variance error: covariant type parameter T in contravariant position
   fun produce() -> T
}

interface Contravariant[-T] {
   fun accept(t: T)
   fun produce() -> T            //> E : variance error: contravariant type parameter T in covariant position
}

interface Invariant[T] {
   fun accept(t: T)
   fun produce() -> T
}
