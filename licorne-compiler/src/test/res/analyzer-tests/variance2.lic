
interface Covariant[out T] {
   fun accept(t: T)            //> E : variance error: 'out' type parameter T is not allowed in this position
   fun produce(): T
}

interface Contravariant[in T] {
   fun accept(t: T)
   fun produce(): T            //> E : variance error: 'in' type parameter T is not allowed in this position
}

interface Invariant[T] {
   fun accept(t: T)
   fun produce(): T
}
