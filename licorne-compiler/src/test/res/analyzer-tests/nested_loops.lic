
object Test {

   fn sum[T](table: Array[Array[T]], evalFunc: fn (T) -> [0..]) -> [0..] {
      var s = 0;
      for (var i = 0; i < table.length(); i += 1) {
         val row = table.at(i);
         for (var j = 0; j < row.length(); j += 1) {
            s += evalFunc(row.at(j));
         };
      };
      return s;
   }

   fn sum_bad[T](table: Array[Array[T]], evalFunc: fn (T) -> [0..]) -> [0..] {
      var s = 0;
      for (var i = 0; i < table.length(); i += 1) {
         val row = table.at(i);
         for (var j = 0; j <= row.length(); j += 1) {
            s += evalFunc(row.at(j));     //> E : first argument of call to at: expected Idx[T](row), found j : [0 .. row.length()]
         };
      };
      return s;
   }

}

typealias Length = [0..]
typealias Idx[T](a: Array[T]) = [0 ..< a.length()]

interface Array[T] {
   pure fn length(this) -> Length
   fn at(this, i: Idx(this)) -> T
}
