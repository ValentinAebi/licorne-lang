
interface Animal[Food] {
   fun eat(food: Food)
}

interface Reptile[Food] : Animal[Food]
interface ReptileEatingInsects : Reptile[List[Insect]]
interface Lizard : ReptileEatingInsects

class Glasworm : Lizard {
   fun eat(insects: List[Insect]){
      // ...
   }
}

class Insect

object Main {

   fun main() {
      feed1(Glasworm(), Insect())
      feed2(Glasworm(), Insect())
   }

   private fun feed1(lizard: Lizard, insect: Insect){
      lizard.eat(insect)   //> E : first argument of call to eat: expected List[Insect], found insect : Insect
   }

   private fun feed2(lizard: Lizard, insect: Insect){
      lizard.eat(Cons(insect, Nil()))
   }

}

sealed interface List[out T]
data class Cons[out T](val head: T, val tail: List[T]) : List[T]
data class Nil : List[Nothing]
