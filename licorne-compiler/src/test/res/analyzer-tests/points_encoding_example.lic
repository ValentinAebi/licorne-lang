import Lists.*;

typealias NonZeroLength = [1..]
typealias Coord(axisSize: NonZeroLength) = [0..<axisSize]

object Encoder {

    fn decodeAll(data: List[Int], xSize: NonZeroLength, ySize: NonZeroLength) -> List[Point[Coord(xSize), Coord(ySize)]] {
        val validData = removeOutliers(data);
        return map(validData, fn (d) -> decode(d, xSize, ySize));
    }

    private fn removeOutliers(data: List[Int]) -> List[[0..]] =
        filter(data, fn (d) -> d >= 0)

    private fn decode(datapoint: [0..], xSize: NonZeroLength, ySize: NonZeroLength) -> Point[Coord(xSize), Coord(ySize)] {
        val x = (datapoint / 64) % xSize;
        val y = datapoint % ySize;
        return new Point(x, y);
    }

}

record Point[I sub Int, J sub Int](x: I, y: J)

datatype List[+T]
record Cons[+T](first: T, rest: List[T]) : List[T]
record Nil() : List[Nothing]

object Lists {

    fn map[T, U](ls: List[T], f: fn (T) -> U) -> List[U] {
        var resultReversed = new Nil();
        for var rem = ls; rem is Cons; rem = rem.rest() {
            resultReversed = new Cons(first = f(rem.first()), rest = resultReversed);
        };
        return reverse(resultReversed);
    }

    fn filter[T](ls: List[T], p: pure fn (T) -> Bool) -> List[T with p(it)] {
        var filteredReversed = new Nil();
        for var rem = ls; rem is Cons; rem = rem.rest() {
            if p(rem.first()) {
                filteredReversed = new Cons(first = rem.first(), rest = filteredReversed);
            }
        };
        return reverse(filteredReversed);
    }

    fn reverse[T](ls: List[T]) -> List[T] {
        var rev = new Nil();
        for var rem = ls; rem is Cons; rem = rem.rest() {
            rev = new Cons(first = rem.first(), rest = rev);
        };
        return rev;
    }

}
