import Lists.*

typealias NonZeroLength = [1..]
typealias Coord(axisSize: NonZeroLength) = [0..<axisSize]

object Encoder {

    fun decodeAll(encodedData: List[Int], xSize: NonZeroLength, ySize: NonZeroLength): List[Point[Coord(xSize), Coord(ySize)]] {
        val validData = removeOutliers(encodedData)
        return map(validData) { decode(it, xSize, ySize) }
    }

    private fun removeOutliers(ls: List[Int]): List[[0..]] =
        filter(ls) { it >= 0 }

    private fun decode(datapoint: [0..], xSize: NonZeroLength, ySize: NonZeroLength): Point[Coord(xSize), Coord(ySize)] {
        val x = (datapoint / 64) % xSize
        val y = datapoint % ySize
        return Point(x, y)
    }

}

data class Point[I : Int, J : Int](val x: I, val y: J)

sealed interface List[out T]
data class Cons[out T](val first: T, val rest: List[T]) : List[T]
data class Nil() : List[Nothing]

object Lists {

    fun map[T, U](ls: List[T], f: (T) -> U): List[U] {
        var resultReversed = Nil()
        for (var rem = ls; rem is Cons; rem = rem.rest()) {
            resultReversed = Cons(f(rem.first()), resultReversed)
        }
        return reverse(resultReversed)
    }

    fun filter[T](ls: List[T], p: pure (T) -> Boolean): List[T with p(it)] {
        var filteredReversed = Nil()
        for (var rem = ls; rem is Cons; rem = rem.rest()) {
            if (p(rem.first())) {
                filteredReversed = Cons(rem.first(), filteredReversed)
            }
        }
        return reverse(filteredReversed)
    }

    fun reverse[T](ls: List[T]): List[T] {
        var rev = Nil()
        for (var rem = ls; rem is Cons; rem = rem.rest()) {
            rev = Cons(rem.first(), rev)
        }
        return rev
    }

}
